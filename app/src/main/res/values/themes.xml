<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- AppCompat DayNight puro, sem Material Components. Theme.Index.Base liga os
         atributos do sistema à paleta idx*; cada Theme.Index.<id> é um tema (fase 11).
         Theme.Index (manifesto, janela de abertura) usa o padrão claro/escuro. -->
    <style name="Theme.Index.Base" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">?attr/idxToolbar</item>
        <item name="colorPrimaryDark">?attr/idxToolbar</item>
        <item name="colorAccent">?attr/idxAccent</item>
        <item name="colorControlActivated">?attr/idxAccent</item>
        <item name="android:colorBackground">?attr/idxBg</item>
        <item name="android:colorBackgroundFloating">?attr/idxSurface</item>
        <item name="android:windowBackground">?attr/idxBg</item>
        <item name="android:textColorPrimary">?attr/idxText</item>
        <item name="android:textColorSecondary">?attr/idxTextSecondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="toolbarStyle">@style/IndexToolbar</item>
        <item name="tileBackground">?attr/idxSurface</item>
    </style>

