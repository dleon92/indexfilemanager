    <attr name="idxSurface" format="color" />
    <attr name="idxToolbar" format="color" />
    <attr name="idxNavBar" format="color" />
    <attr name="idxText" format="color" />
    <attr name="idxTextSecondary" format="color" />
    <attr name="idxAccent" format="color" />
    <attr name="idxOnAccent" format="color" />
    <attr name="idxSelection" format="color" />
    <attr name="idxWarning" format="color" />
</resources>
