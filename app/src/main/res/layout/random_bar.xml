<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso da seleção aleatória ("10 aleatórios de 1.000") com as ações. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/random_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/tileBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/random_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Index.Body" />

    <Button
        android:id="@+id/random_again"
        style="@style/Widget.AppCompat.Button.Borderless.Colored"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/random_again" />

    <Button
        android:id="@+id/random_full"
        style="@style/Widget.AppCompat.Button.Borderless.Colored"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/random_full" />
</LinearLayout>
