<?xml version="1.0" encoding="utf-8"?>
<!-- Criar/alterar a senha própria do Index: tipo, senha e confirmação. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="8dp">

    <TextView
        android:id="@+id/setup_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textAppearance="@style/TextAppearance.Index.Secondary"
        android:visibility="gone" />

    <RadioGroup
        android:id="@+id/setup_kind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/setup_pin"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:checked="true"
            android:text="@string/lock_kind_pin" />

        <RadioButton
            android:id="@+id/setup_password"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/lock_kind_password" />
    </RadioGroup>

    <EditText
        android:id="@+id/setup_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:hint="@string/lock_new_pin"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:minHeight="48dp" />

    <EditText
        android:id="@+id/setup_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:autofillHints=""
        android:hint="@string/lock_confirm_pin"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:minHeight="48dp" />

    <TextView
        android:id="@+id/setup_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/warning"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
