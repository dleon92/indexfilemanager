<?xml version="1.0" encoding="utf-8"?>
<!-- Visualizador de fotos: páginas na horizontal; barra e setas somem com um toque. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clickable="true"
    android:focusable="true">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/viewer_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never" />

    <LinearLayout
        android:id="@+id/viewer_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/viewer_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <ImageButton
            android:id="@+id/viewer_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/viewer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/viewer_counter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/viewer_share"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/share"
            android:src="@drawable/ic_share"
            android:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/viewer_open_with"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/open_with"
            android:src="@drawable/ic_open_with"
            android:tint="#FFFFFFFF" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/viewer_prev"
        android:layout_width="48dp"
        android:layout_height="72dp"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/viewer_side_button"
        android:contentDescription="@string/viewer_prev"
        android:src="@drawable/ic_chevron_left" />

    <ImageButton
        android:id="@+id/viewer_next"
        android:layout_width="48dp"
        android:layout_height="72dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/viewer_side_button"
        android:contentDescription="@string/viewer_next"
        android:src="@drawable/ic_chevron_right" />
</FrameLayout>
