<?xml version="1.0" encoding="utf-8"?>
<!-- Progresso de "Carregar todas as miniaturas" ("1.240 / 5.000"), com cancelar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/preload_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/tileBackground"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    android:visibility="gone">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_bolt" />

    <TextView
        android:id="@+id/preload_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Index.Body" />

    <Button
        android:id="@+id/preload_cancel"
        style="@style/Widget.AppCompat.Button.Borderless.Colored"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cancel" />
</LinearLayout>
